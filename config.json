{
  "ai_base_url": "https://openrouter.ai/api/v1",
  "ai_model": "openrouter/free",
  "ai_provider": "openai",
  "close_on_original_click": false,
  "hotkey": {
    "key": "l",
    "modifiers": [
      "ctrl",
      "shift"
    ]
  },
  "hotkeys": {
    "toggle": {
      "modifiers": [
        "ctrl"
      ],
      "key": "l"
    },
    "search": {
      "modifiers": [
        "alt"
      ],
      "key": "f"
    },
    "scroll_up": {
      "modifiers": [
        "alt"
      ],
      "key": "up"
    },
    "scroll_down": {
      "modifiers": [
        "alt"
      ],
      "key": "down"
    },
    "prev_law": {
      "modifiers": [
        "alt"
      ],
      "key": "left"
    },
    "next_law": {
      "modifiers": [
        "alt"
      ],
      "key": "right"
    }
  },
  "scroll_speed": 100,
  "window": {
    "height": 760,
    "opacity": 0.97,
    "width": 1300
  }
}