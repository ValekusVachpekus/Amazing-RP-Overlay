# Reproducible user-mode-only dependency. Upstream's driver loader is disabled
# in a generated source file; no driver, privilege enabling or stealth flags.
FetchContent_Declare(blackbone GIT_REPOSITORY https://github.com/DarthTon/Blackbone.git
  GIT_TAG 5ede6ce50cd8ad34178bfa6cae05768ff6b3859b)
FetchContent_GetProperties(blackbone)
if(NOT blackbone_POPULATED)
  FetchContent_Populate(blackbone)
endif()
set(bb "${blackbone_SOURCE_DIR}/src/BlackBone")
file(READ "${bb}/BlackBone.vcxproj" bb_project)
string(REGEX MATCHALL "<ClCompile Include=\"[^\"]+\"" bb_entries "${bb_project}")
set(bb_sources)
foreach(entry IN LISTS bb_entries)
  string(REGEX REPLACE "<ClCompile Include=\"([^\"]+)\"" "\\1" entry "${entry}")
  string(REPLACE "\\" "/" entry "${entry}")
  if(NOT entry STREQUAL "DllMain.cpp")
    list(APPEND bb_sources "${bb}/${entry}")
  endif()
endforeach()
foreach(pair "Misc/InitOnce.cpp" "DriverControl/DriverControl.cpp")
  file(READ "${bb}/${pair}" source)
  if(pair STREQUAL "Misc/InitOnce.cpp")
    string(REPLACE "GrantPriviledge( L\"SeDebugPrivilege\" );" "/* No debug privilege escalation. */" source "${source}")
    string(REPLACE "GrantPriviledge( L\"SeLoadDriverPrivilege\" );" "/* Driver loading is disabled. */" source "${source}")
  else()
    string(REPLACE "// Already open" "return STATUS_NOT_SUPPORTED; // AmazingHelper never loads/opens a kernel driver.\n    // Already open" source "${source}")
  endif()
  get_filename_component(filename "${pair}" NAME)
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/blackbone-${filename}" "${source}")
  list(REMOVE_ITEM bb_sources "${bb}/${pair}")
  list(APPEND bb_sources "${CMAKE_CURRENT_BINARY_DIR}/blackbone-${filename}")
endforeach()
add_library(blackbone_user STATIC ${bb_sources})
target_include_directories(blackbone_user PUBLIC "${blackbone_SOURCE_DIR}/src"
  "${blackbone_SOURCE_DIR}/src/3rd_party" PRIVATE "${bb}/Misc" "${bb}/DriverControl")
target_compile_definitions(blackbone_user PUBLIC BLACKBONE_STATIC UNICODE _UNICODE
  PRIVATE BLACKBONE_NO_TRACE _CRT_SECURE_NO_WARNINGS _SILENCE_ALL_CXX17_DEPRECATION_WARNINGS)
target_compile_options(blackbone_user PRIVATE /utf-8 /w)
find_library(DIA_GUIDS diaguids HINTS "${CMAKE_GENERATOR_INSTANCE}/DIA SDK/lib" "$ENV{VSINSTALLDIR}/DIA SDK/lib" REQUIRED)
target_link_libraries(blackbone_user PUBLIC ntdll shlwapi version psapi winhttp ole32 oleaut32 advapi32 "${DIA_GUIDS}")
